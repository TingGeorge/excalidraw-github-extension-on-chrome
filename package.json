{
  "name": "excalidraw-github-preview",
  "version": "1.0.1",
  "private": true,
  "description": "Chrome extension that previews Excalidraw diagrams on GitHub — blob pages, inline, and pull request diffs.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "screenshots": "SCREENSHOTS=1 playwright test test/e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "lz-string": "1.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@primer/css": "22.3.2",
    "@primer/primitives": "11.10.0",
    "@primer/react": "38.40.1",
    "@types/chrome": "0.3.5",
    "@types/node": "22.20.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "sass": "^1.93.0",
    "katex": "^0.18.2",
    "lodash-es": "^4.18.1",
    "nanoid@<4": "^3.3.20",
    "nanoid@>=4": "^5.1.16"
  }
}
